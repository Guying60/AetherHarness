{
  "name": "aether-harness",
  "version": "2.2.0",
  "description": "AetherHarness / DSH-Orchestrator — multi-agent self-healing orchestration, dynamic scheduling, 3-tier verification and dual Web/TUI presentation platform",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "aether": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsc -p tsconfig.json && node dist/src/cli.js",
    "tui": "node dist/src/cli.js",
    "auto": "node dist/src/cli.js --auto",
    "live": "node dist/src/cli.js --live",
    "preview": "node dist/src/cli.js --frames 3",
    "web": "tsc -p tsconfig.json && node dist/src/cli.js --web",
    "demo": "tsc -p tsconfig.json && node dist/src/demo.js",
    "headless": "node dist/src/demo.js",
    "test": "tsc -p tsconfig.json && node dist/tests/run-tests.js"
  },
  "keywords": [
    "multi-agent",
    "orchestration",
    "self-loop",
    "pdca",
    "scheduler",
    "verification",
    "tui",
    "deepseek-harness"
  ],
  "author": "AetherHarness team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.0.2"
  }
}
